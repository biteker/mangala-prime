# Veritabanı Bağlantı URL'i (PostgreSQL)
DATABASE_URL="postgresql://postgres:<DB_PASSWORD>@localhost:5432/mangala_db?schema=public&connection_limit=3"

# Oyun Hamle Süresi Limiti (saniye cinsinden)
GAME_TURN_TIME_LIMIT_SECS=59

# JWT Gizli Anahtarları (Üretimde rastgele güçlü 64+ karakterlik string kullanılmalıdır)
JWT_SECRET="degistirin_guclu_uretim_jwt_secret_anahtari_1234567890_mangala"
JWT_REFRESH_SECRET="degistirin_guclu_uretim_refresh_secret_anahtari_0987654321_mangala"

# CORS İzinli Origin Listesi (Virgülle ayrılmış alan adları)
CORS_ORIGIN="https://mangala-prime.egitimhaber.gen.tr,http://localhost:5173,http://127.0.0.1:5173"

# Çalışma Ortamı ve Port
NODE_ENV=production
PORT=3000
