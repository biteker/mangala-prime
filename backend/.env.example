# Veritabanı Bağlantı URL'i (PostgreSQL)
DATABASE_URL="postgresql://postgres:<DB_PASSWORD>@localhost:5432/mangala_db?schema=public&connection_limit=3"

# Oyun Hamle Süresi Limiti (saniye cinsinden, 10-300 arası)
GAME_TURN_TIME_LIMIT_SECS=59

# JWT Gizli Anahtarları (Zorunlu, birbirinden farklı ve en az 32 karakter)
JWT_SECRET="<64+_KARAKTER_RASTGELE_JWT_SECRET>"
JWT_REFRESH_SECRET="<64+_KARAKTER_RASTGELE_JWT_REFRESH_SECRET>"

# CORS İzinli Origin Listesi (Virgülle ayrılmış alan adları; production'da zorunlu)
CORS_ORIGIN="https://mangala-prime.egitimhaber.gen.tr,http://localhost:5173,http://127.0.0.1:5173"

# Çalışma Ortamı ve Port
NODE_ENV=production
PORT=3000
